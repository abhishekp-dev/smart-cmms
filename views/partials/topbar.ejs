<header class="topbar px-3 px-lg-4 py-3 d-flex justify-content-between align-items-center" style="position: relative; z-index: 1050;">
  <div>
    <div class="text-muted small">JK Fenner Computerized Maintenance Management System</div>
    <h2 class="h4 mb-0"><%= title %></h2>
  </div>
  <div class="d-flex align-items-center gap-3">
    <div class="dropdown">
      <button class="btn btn-outline-secondary position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bell" viewBox="0 0 16 16">
          <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5.002 5.002 0 0 1 13 6c0 .88.32 4.2 1.22 6z"/>
        </svg>
        <% if (locals.notifications && locals.notifications.length > 0) { %>
          <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
            <span class="visually-hidden">New alerts</span>
          </span>
        <% } %>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="width: 300px; max-height: 400px; overflow-y: auto;">
        <li><h6 class="dropdown-header">Notifications</h6></li>
        <% if (!locals.notifications || locals.notifications.length === 0) { %>
          <li><span class="dropdown-item text-muted small">No new notifications</span></li>
        <% } else { %>
          <% locals.notifications.forEach(n => { %>
            <li class="border-bottom">
              <div class="dropdown-item text-wrap py-2">
                <div class="small mb-1"><%= n.message %></div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <span class="text-muted" style="font-size: 0.7rem;"><%= new Date(n.created_at).toLocaleString() %></span>
                  <form method="POST" action="/notifications/<%= n.id %>/read" class="m-0">
                    <button type="submit" class="btn btn-link btn-sm text-decoration-none p-0" style="font-size: 0.75rem;">Mark Read</button>
                  </form>
                </div>
              </div>
            </li>
          <% }) %>
        <% } %>
      </ul>
    </div>
    <form method="POST" action="/logout" class="m-0">
      <button class="btn btn-outline-dark btn-sm">Logout</button>
    </form>
  </div>
</header>
