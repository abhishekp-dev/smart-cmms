<%- include('partials/header', { title }) %>
<div class="app-shell d-lg-flex">
  <%- include('partials/sidebar') %>

  <div class="content-area">
    <%- include('partials/topbar', { title: machine.name }) %>

    <main class="p-3 p-lg-4">
      <div class="row g-4">
        <div class="col-xl-4">
          <div class="surface-card p-4 h-100 <%= machine.status === 'Breakdown' ? 'highlight-danger' : '' %>">
            <div class="d-flex justify-content-between align-items-start mb-4">
              <div>
                <div class="text-muted small">Machine</div>
                <div class="d-flex align-items-center gap-2">
                  <h3 class="h4 mb-0"><%= machine.name %></h3>
                  <button class="btn btn-sm btn-outline-secondary p-1 d-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#qrModal" title="Show QR Code">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-qr-code" viewBox="0 0 16 16">
                      <path d="M2 2h2v2H2V2Z"/>
                      <path d="M6 0v6H0V0h6ZM5 1H1v4h4V1ZM4 12H2v2h2v-2Z"/>
                      <path d="M6 10v6H0v-6h6Zm-5 1v4h4v-4H1Zm11-9h2v2h-2V2Z"/>
                      <path d="M10 0v6h6V0h-6Zm5 1v4h-4V1h4ZM8 1V0h1v2H8v2H7V1h1Zm0 5V4h1v2H8ZM6 8V7h1V6h1v2h1V7h5v1h-4v1H7V8H6Zm0 0v1H2V8H1v1H0V7h3v1h3Zm10 1h-1V7h1v2Zm-1 0h-1v2h2v-1h-1V9Zm-4 0h2v1h-1v1h-1V9Zm2 3v-1h-1v1h1Zm-1 0v1h2v-1h-2Zm-4 0v-1h1v1h-1Zm2 0h-1v2h1v-2Zm-2 2v-1h-1v1h1Zm-1 0v1h2v-1h-2Zm2 0h1v-1h-1v1Zm3 0v1h1v-1h-1Zm-1-1h1v-1h-1v1ZM9 9v1h1V9H9Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <span class="status-pill status-<%= machine.status.toLowerCase() %>"><%= machine.status %></span>
            </div>
            <div class="mb-3">
              <div class="small text-muted">Working Hours</div>
              <div class="fw-semibold"><%= machine.working_hours %>h</div>
            </div>
            <div class="mb-3">
              <div class="small text-muted">Idle Hours</div>
              <div class="fw-semibold"><%= machine.idle_hours %>h</div>
            </div>
            <div class="mb-3">
              <div class="small text-muted">Last Service Date</div>
              <div class="fw-semibold"><%= machine.last_service_date || '-' %></div>
            </div>
            <div>
              <div class="small text-muted">Next Service Date</div>
              <div class="fw-semibold"><%= machine.next_service_date || '-' %></div>
            </div>
          </div>
        </div>

        <div class="col-xl-8">
          <div class="surface-card p-4 mb-4" id="predictive-module">
            <div class="section-title mb-3 d-flex justify-content-between align-items-center">
              <span>Predictive Maintenance Engine</span>
              <span id="risk-badge" class="badge bg-secondary">Loading...</span>
            </div>
            <div class="row g-3" id="prediction-data" style="display: none;">
              <div class="col-sm-4">
                <div class="border rounded-4 p-3 text-center">
                  <div class="small text-muted mb-1">Predicted MTBF</div>
                  <div class="h4 mb-0" id="pred-mtbf">-</div>
                  <div class="small mt-1 fw-bold" id="pred-trend">-</div>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="border rounded-4 p-3 text-center">
                  <div class="small text-muted mb-1">Predicted MTTR</div>
                  <div class="h4 mb-0" id="pred-mttr">-</div>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="border rounded-4 p-3 text-center">
                  <div class="small text-muted mb-1">Failure Probability</div>
                  <div class="h4 mb-0" id="pred-prob">-</div>
                </div>
              </div>
            </div>
            
            <script>
              document.addEventListener('DOMContentLoaded', () => {
                fetch('/predict/<%= machine.id %>')
                  .then(res => res.json())
                  .then(data => {
                    document.getElementById('prediction-data').style.display = 'flex';
                    document.getElementById('pred-mtbf').innerText = data.predicted_mtbf + 'h';
                    document.getElementById('pred-mttr').innerText = data.predicted_mttr + 'h';
                    document.getElementById('pred-prob').innerText = data.failure_probability + '%';
                    
                    const trendEl = document.getElementById('pred-trend');
                    trendEl.innerText = data.trend;
                    if(data.trend === 'DECREASING') trendEl.className = 'small mt-1 fw-bold text-danger';
                    else if(data.trend === 'INCREASING') trendEl.className = 'small mt-1 fw-bold text-success';
                    else trendEl.className = 'small mt-1 fw-bold text-muted';
                    
                    const badge = document.getElementById('risk-badge');
                    badge.innerText = data.risk_level + ' RISK';
                    if(data.risk_level === 'HIGH') badge.className = 'badge bg-danger';
                    else if(data.risk_level === 'MEDIUM') badge.className = 'badge bg-warning text-dark';
                    else badge.className = 'badge bg-success';
                  })
                  .catch(err => {
                    document.getElementById('risk-badge').innerText = 'Data Unavailable';
                  });
              });
            </script>
          </div>

          <div class="surface-card p-4 mb-4">
            <div class="section-title mb-3">Components</div>
            <div class="row g-3">
              <% components.forEach((component) => { %>
                <div class="col-sm-6">
                  <div class="border rounded-4 p-3"><%= component.name %></div>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="surface-card p-4 mb-4">
            <div class="section-title mb-3">Materials Used</div>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr>
                    <th>Material</th>
                    <th>Total Used</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (materialUsage.length === 0) { %>
                    <tr><td colspan="2" class="text-muted">No usage logged yet.</td></tr>
                  <% } %>
                  <% materialUsage.forEach((item) => { %>
                    <tr>
                      <td><%= item.name %></td>
                      <td><%= item.total_used %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="surface-card p-4">
            <div class="section-title mb-3">Maintenance History</div>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr>
                    <th>Work Order</th>
                    <th>Technician</th>
                    <th>Status</th>
                    <th>Failure Time</th>
                  </tr>
                </thead>
                <tbody>
                  <% workOrders.forEach((order) => { %>
                    <tr>
                      <td><%= order.title %></td>
                      <td><%= order.technician_name || 'Unassigned' %></td>
                      <td><span class="status-pill status-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>"><%= order.status %></span></td>
                      <td><%= order.failure_time ? new Date(order.failure_time).toLocaleString() : '-' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- QR Code Modal -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title" id="qrModalLabel">Machine QR Code</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center pb-4">
        <div class="p-3 bg-white d-inline-block rounded shadow-sm mb-3">
          <img id="qr-code-img" src="" alt="QR Code" width="200" height="200" />
        </div>
        <p class="text-muted small mb-0">Scan this code with a mobile device to quickly access this machine's dashboard.</p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const qrModal = document.getElementById('qrModal');
    qrModal.addEventListener('show.bs.modal', () => {
      const qrImg = document.getElementById('qr-code-img');
      const currentUrl = encodeURIComponent(window.location.href);
      qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${currentUrl}&margin=10`;
    });
  });
</script>

<%- include('partials/footer') %>
